# Copy to server/.env on the VPS and fill in production values.

SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=False
DJANGO_SETTINGS_MODULE=Backend.settings

# Nginx public hostname/origins. Comma-separate multiple values.
ALLOWED_HOSTS=brand-baggy.duckdns.org,backend,brandbaggy_backend
CORS_ALLOWED_ORIGINS=https://brand-baggy.duckdns.org
CSRF_TRUSTED_ORIGINS=https://brand-baggy.duckdns.org
FRONT_END_URL=https://brand-baggy.duckdns.org
RENDER_EXTERNAL_HOSTNAME=

# Existing shared containers on shared_network.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/brand_baggy
REDIS_URL=redis://redis:6379/0

# Email.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# Cloudinary.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe.
STRIPE_SECRET_KEY=sk_live_or_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal.
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPALWEBHOOK_ID=your_paypal_webhook_id
PAYPAL_API_BASE=https://api-m.paypal.com
